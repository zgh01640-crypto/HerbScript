# MySQL
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=herbscript
MYSQL_USER=herbscript
MYSQL_PASSWORD=replace-with-a-strong-app-password

# Public port for Nginx
PUBLIC_HTTP_PORT=80

# Frontend
# Leave empty to use same-origin access through Nginx.
VITE_API_BASE_URL=

# Doubao / Ark
DOUBAO_API_KEY=replace-with-your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
DOUBAO_MODEL=doubao-seed-2-0-pro
DOUBAO_CHAT_PATH=/chat/completions
DOUBAO_FALLBACK_TO_MOCK_ON_ERROR=false
